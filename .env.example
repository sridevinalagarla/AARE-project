# ProofA11y Engine Environment Configuration

PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector)
# If not configured, local in-memory/JSON store fallback is automatically used.
DATABASE_URL=postgresql://proofa11y:proofa11y_password@localhost:5432/proofa11y_db
VECTOR_DATABASE_URL=postgresql://proofa11y:proofa11y_password@localhost:5432/proofa11y_db

# Redis Cache & Queue
# If not configured, in-memory queue fallback is automatically used.
REDIS_URL=redis://localhost:6379

# S3 Compatible File Storage
# If not configured, local disk storage fallback is automatically used.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=proofa11y-artifacts

# Authentication
JWT_SECRET=proofa11y-super-secret-jwt-key-2026

# Optional AI / LLM Integration (Gemini / OpenAI API compatible)
# If not provided, robust deterministic rule-based repair engine is used.
AI_API_KEY=
