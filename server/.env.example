# ==========================================
# ProofA11y Backend Configuration Template
# Copy this file to .env and fill in real values
# ==========================================

PORT=3001
NODE_ENV=development

# PostgreSQL / Supabase Connection String
# Example: "postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://username:password@localhost:5432/proofa11y_db"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# AI / LLM Secret API Key (Keep strictly secret on backend)
AI_API_KEY=""

# JWT Authentication Secret Key
JWT_SECRET="your-256-bit-secret-jwt-key"

# S3 Compatible File Storage (Optional)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_BUCKET="proofa11y-artifacts"
